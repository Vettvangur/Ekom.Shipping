<Project>
  <!-- Machine-specific settings (not committed): set UseProjectReferences and EkomRoot to build against a local Ekom checkout. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
  <PropertyGroup>
    <!-- true: reference the Ekom project in EkomRoot. false: reference the Ekom.Core NuGet package. -->
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">false</UseProjectReferences>
    <EkomRoot Condition="'$(EkomRoot)' == ''">$(MSBuildThisFileDirectory)..\Ekom\</EkomRoot>
    <!-- The lowest Ekom version these carriers work with: the first with the shipping framework and shipment records. -->
    <EkomVersion Condition="'$(EkomVersion)' == ''">1.3.0</EkomVersion>
  </PropertyGroup>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Authors>Vettvangur</Authors>
    <Company>Vettvangur</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Vettvangur/Ekom.Shipping</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Vettvangur/Ekom.Shipping</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ekom;umbraco;ecommerce;shipping</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Ekom_Logo.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/"/>
    <None Include="$(MSBuildThisFileDirectory)Ekom_Logo.png" Pack="true" PackagePath="/" Visible="false"/>
  </ItemGroup>
</Project>
