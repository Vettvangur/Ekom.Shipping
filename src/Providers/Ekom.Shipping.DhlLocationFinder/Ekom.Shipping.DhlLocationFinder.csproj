<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Ekom.Shipping.DhlLocationFinder</PackageId>
    <Version>0.1.1</Version>
    <Description>Typed DHL Location Finder Unified client for Ekom.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>
  <!-- Ekom owns the carrier contracts and the order shipment records. -->
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="$(EkomRoot)Ekom\Ekom.Core\Ekom\Ekom.csproj"/>
  </ItemGroup>
  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="Ekom.Core" Version="$(EkomVersion)"/>
  </ItemGroup>
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)../../../README.md"/>
    <None Update="README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>
</Project>
